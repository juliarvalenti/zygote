{
  "name": "orbs",
  "nodes": [
    { "id": "cells",  "type": "voronoi", "params": { "mode": "bubbles", "scale": 4, "speed": 0.45, "jitter": 1.0, "contrast": 1.0 } },
    { "id": "warm",   "type": "color_grade", "inputs": ["cells"], "params": { "preset": "ember", "palette_mix": 1.0, "saturation": 1.2 } },
    { "id": "rise",   "type": "streak", "inputs": ["warm"], "params": { "angle": 0.25, "distance": 0.003, "decay": 0.9, "spread": 0.002 } },
    { "id": "glow",   "type": "blur", "inputs": ["rise"], "params": { "radius": 0.045, "threshold": 0.45, "gain": 1.3, "direction": "both" } },
    { "id": "bloom",  "type": "blend", "inputs": ["rise", "glow"], "params": { "mode": "add", "mix": 0.85 } },
    { "id": "frame",  "type": "vignette", "inputs": ["bloom"], "params": { "amount": 0.75, "radius": 0.45, "softness": 0.7, "tint": "#050410" } }
  ],
  "output": "frame"
}
